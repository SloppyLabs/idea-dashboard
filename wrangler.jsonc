{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "idea-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "PLACEHOLDER_RUN_SETUP_SH"
    }
  ],
  "observability": {
    "enabled": true
  }
}
