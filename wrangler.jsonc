{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "idea-dashboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Without this the static-asset layer answers /api/* first and can 404 it.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "1d2237b2581e44a1a48f357ce8eef48f"
    }
  ],
  "observability": {
    "enabled": true
  }
}
